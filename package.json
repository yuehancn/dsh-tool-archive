{
  "name": "dsh-tool-archive",
  "version": "1.0.0",
  "description": "Archive tools for DeepSeek Harness: pack a directory into a deterministic tar, read an archive's contents without extracting it, unpack a tar while refusing every member that could reach outside the destination, and verify what came out against what went in. No external dependency; the tar format is written and read here.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "archive",
    "tar",
    "untar",
    "extract",
    "zip-slip",
    "path-traversal",
    "sha256",
    "deterministic",
    "manifest",
    "mcp",
    "归档"
  ],
  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-archive.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-archive#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-archive/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}